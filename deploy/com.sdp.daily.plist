<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The daily pull of the data lake.

  Install:
    cp deploy/com.sdp.daily.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.sdp.daily.plist

  Run once by hand:
    launchctl kickstart -k gui/$(id -u)/com.sdp.daily

  Remove:
    launchctl bootout gui/$(id -u)/com.sdp.daily

  This uses launchd and not cron. On macOS, cron skips a job when the machine
  is asleep at the scheduled time and it never runs it. launchd runs a missed
  job when the machine wakes.

  The machine is on Europe/London. The S3 flat file for session D was
  measured to land between 04:50 and 05:40 UTC on D+1, so every tick here is
  well clear of it. Change the hours if the machine moves to another
  timezone.

  The ticks are hourly from 17:00 to 00:00 local. Network availability on
  this machine is not constant, so one tick a day is one chance a day. Each
  tick is a further chance.

  A repeat tick is cheap. The event streams skip a session that is already
  published. The corporate action tables have no partition to skip, so each
  tick builds them again from the vendor file that is already on disk, which
  is measured at 3 seconds for the two together. That rebuild also runs the
  audits again, so a repeat tick is a check and not only a cost.

  The pull date is the UTC date and not the local date. On BST, which is
  UTC+1, the UTC date changes at 01:00 local, so every tick from 17:00 to
  00:00 writes the same pull date.

  The ticks are chances only while the machine is awake. launchd combines
  the ticks that pass during sleep into one run on wake. To capture a date
  with certainty, run the command by hand:

    uv run python -m sdp.daily
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sdp.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>python</string>
        <string>-m</string>
        <string>sdp.daily</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/aray/strategic-data-platform</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/aray/strategic-data-platform/data/_logs/daily.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/aray/strategic-data-platform/data/_logs/daily.err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
