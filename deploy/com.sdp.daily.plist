<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hourly update: pull new data, rebuild the warehouse if anything changed, write the status.
  Install with deploy/install_agents.sh, which fills in __REPO__.

  launchd rather than cron because it runs a missed job when the machine wakes.
  Standard rather than Background: macOS pins Background jobs to the efficiency cores and
  throttles their disk I/O, which makes the dbt build crawl. Nice 10 keeps it polite.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sdp.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/.venv/bin/python</string>
        <string>-m</string>
        <string>sdp.daily</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>5</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__REPO__/data/_logs/daily.out.log</string>

    <key>StandardErrorPath</key>
    <string>__REPO__/data/_logs/daily.err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Standard</string>

    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
