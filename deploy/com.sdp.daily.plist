<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The daily update of the data lake: pull, then build the dbt models when a new
  session landed, then write data/_logs/status.json for the dashboard.

  Install:  cp deploy/com.sdp.daily.plist ~/Library/LaunchAgents/
            launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.sdp.daily.plist
  Run now:  launchctl kickstart -k gui/$(id -u)/com.sdp.daily
  Remove:   launchctl bootout gui/$(id -u)/com.sdp.daily

  launchd, not cron: cron skips a job the machine slept through, launchd runs it
  on wake. Three attempts a day in Europe/London: 08:00 (after session D-1's S3
  flat file lands ~06:00 UTC), and 13:00 and 20:00 as fallbacks for a machine
  that was asleep at 08:00. A repeat is cheap: sdp.daily skips a published
  session and rebuilds the dbt models only when raw changed. Times are local, so
  change them if the machine changes timezone.

  It runs the venv interpreter, not `uv run`, because two `uv run` calls race on
  the venv (the same reason run_backfill.sh does this).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sdp.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/aray/strategic-data-platform/.venv/bin/python</string>
        <string>-m</string>
        <string>sdp.daily</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/aray/strategic-data-platform</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/aray/strategic-data-platform/data/_logs/daily.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/aray/strategic-data-platform/data/_logs/daily.err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
