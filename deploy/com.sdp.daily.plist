<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The daily pull of the data lake.

  Install:  cp deploy/com.sdp.daily.plist ~/Library/LaunchAgents/
            launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.sdp.daily.plist
  Run now:  launchctl kickstart -k gui/$(id -u)/com.sdp.daily
  Remove:   launchctl bootout gui/$(id -u)/com.sdp.daily

  launchd, not cron: cron skips a job the machine slept through, launchd runs it
  on wake. Hourly ticks 17:00-00:00 local, because the network is not always up
  and each tick is another chance. A repeat tick is cheap: event streams skip a
  published session, and the corporate action rebuild takes ~3s and re-runs its
  audits. The pull date is the UTC date, so on BST every tick writes the same one.
  To capture a date for certain, run it by hand: uv run python -m sdp.daily
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sdp.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>python</string>
        <string>-m</string>
        <string>sdp.daily</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/aray/strategic-data-platform</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/aray/strategic-data-platform/data/_logs/daily.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/aray/strategic-data-platform/data/_logs/daily.err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
