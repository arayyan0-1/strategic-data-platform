<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The local dashboard on http://127.0.0.1:8787, kept running.
  Install with deploy/install_agents.sh, which fills in __REPO__.

  A pull started from the page builds in this process, so it gets the same
  Standard process type and Nice 10 as the hourly job.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sdp.dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/.venv/bin/python</string>
        <string>-m</string>
        <string>sdp.dashboard</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__REPO__/data/_logs/dashboard.out.log</string>

    <key>StandardErrorPath</key>
    <string>__REPO__/data/_logs/dashboard.err.log</string>

    <key>ProcessType</key>
    <string>Standard</string>

    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
