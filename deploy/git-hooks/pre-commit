#!/usr/bin/env bash
# Run ruff on the staged Python files. Enable with: git config core.hooksPath deploy/git-hooks
set -u

ROOT="$(git rev-parse --show-toplevel)" || exit 1
RUFF="$ROOT/.venv/bin/ruff"
[ -x "$RUFF" ] || exit 0

files=()
while IFS= read -r f; do
    [ -n "$f" ] && files+=("$ROOT/$f")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.py')

[ "${#files[@]}" -eq 0 ] && exit 0
"$RUFF" check "${files[@]}" || {
    echo "pre-commit: ruff failed. Fix the errors above or run 'ruff check --fix'." >&2
    exit 1
}
